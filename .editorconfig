# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# Visual Basic files
[*.vb]
indent_style = space
indent_size = 4

# C# files
[*.cs]
indent_style = space
indent_size = 4
