<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>osi.production.test_http_server</RootNamespace>
    <AssemblyName>osi.production.test_http_server</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System" />
    <Compile Remove="My Project\**" />
  </ItemGroup>

  <Import Project="..\..\root\root.production.net8.props" />
  <Import Project="$(ServicePath)\http\http.net8.props" />
</Project>
